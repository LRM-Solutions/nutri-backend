generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// ======================
/// =       Nutricionista      =
/// ======================

model Nutricionista {
  nutricionista_id    Int          @id @default(autoincrement())
  nutricionista_nome  String
  nutricionista_cpf   String       @unique
  nutricionista_email String       @unique
  nutricionista_senha String
  assinaturas         Assinatura[]
  exames              Exame[]
  pacientes           Paciente[]
  anamneseperguntas   AnamnesePerguntas[]
}

/// ======================
/// =       Paciente      =
/// ======================

model Paciente {
  paciente_id      Int           @id @default(autoincrement())
  paciente_nome    String
  paciente_cpf     String        @unique
  paciente_email   String        @unique
  nutricionista_id Int
  paciente_senha   String
  exames           Exame[]
  Nutricionista    Nutricionista @relation(fields: [nutricionista_id], references: [nutricionista_id])
}

model Plano {
  plano_id        Int          @id @default(autoincrement())
  plano_descricao String
  assinaturas     Assinatura[]
}

model Assinatura {
  assinatura_id          Int           @id @default(autoincrement())
  nutricionista_id       Int
  plano_id               Int
  assinatura_data_inicio DateTime      @default(now())
  Nutricionista          Nutricionista @relation(fields: [nutricionista_id], references: [nutricionista_id])
  Plano                  Plano         @relation(fields: [plano_id], references: [plano_id])
}

/// ======================
/// =       Exame        =
/// ======================

model Exame {
  exame_id         Int           @id @default(autoincrement())
  exame_descricao  String
  exame_data       DateTime
  nutricionista_id Int
  paciente_id      Int
  Nutricionista    Nutricionista @relation(fields: [nutricionista_id], references: [nutricionista_id])
  Paciente         Paciente      @relation(fields: [paciente_id], references: [paciente_id])
  antropometrica Antropometria[]
  anamnese Anamnese[]

}

/// ======================
/// =    Antropometria   =
/// ======================

model Antropometria {
  antropometria_id Int   @id @default(autoincrement())
  exame_id         Int @unique
  antropometria_data       DateTime
  
  Exame            Exame @relation(fields: [exame_id], references: [exame_id])
  
  dadosBasicos     DadosBasicosAntropometria[]
  dobraCutanea     DobraCutanea[]
  bioimpedancia    Bioimpedancia[]
}

model DadosBasicosAntropometria {
  dadobasico_id               Int    @id @default(autoincrement())
  antropometria_id  Int    @unique
  tipoPaciente     Int
  altura           Float
  alturaSentado    Float?
  alturaJoelho     Float?
  peso             Float
  sexo             String?
  relatorioAnexo   String?
  dataColeta       DateTime @default(now())

  antropometria    Antropometria @relation(fields: [antropometria_id], references: [antropometria_id], onDelete: Cascade)
}


//
model Bioimpedancia {
  bioimpedancia_id    Int      @id @default(autoincrement())
  antropometria_id    Int @unique
  percentGordura      Float?
  percentMassaMagra   Float?
  massaGorda          Float?
  massaMagra          Float?
  pesoOsseo           Float?
  aguaCorporal        Float?
  idadeMetabolica     Int?
  dataColeta          DateTime @default(now())

  // Relações
  antropometria       Antropometria @relation(fields: [antropometria_id], references: [antropometria_id], onDelete: Cascade)
} 

model DobraCutanea {
  dobracutanea_id               Int    @id @default(autoincrement())
  antropometria_id  Int @unique
  tricipal         Float?
  bicipital        Float?
  subescapular     Float?
  suprailiaca      Float?
  abdominal        Float?
  coxa             Float?
  peitoral         Float?
  axiliarMedia     Float?
  dataColeta       DateTime @default(now())

  antropometria    Antropometria @relation(fields: [antropometria_id], references: [antropometria_id], onDelete: Cascade)
}

/// ======================
/// =      Anamnesse     =
/// ======================

model AnamnesePerguntas{
  anamnesePerguntas_id Int @id @default(autoincrement())
  nutricionista_id Int 
  titulo String
  conteudo String?
  data    DateTime @default(now())

  nutricionista Nutricionista @relation(fields: [nutricionista_id], references: [nutricionista_id], onDelete: Cascade)
}

model Anamnese{
  anamnese_id Int @id @default(autoincrement())
  exame_id Int
  titulo String
  conteudo String?
  // Anexo ??
  data DateTime @default(now())
  // Relação exames
  exame Exame @relation(fields: [exame_id], references: [exame_id], onDelete: Cascade)
}

/// ======================
/// = Gastos Energéticos =
/// ======================

model GastosEnergeticos{
  gasto_energetico_id Int @id @default(autoincrement())
  // antropometria_id <=> ele vai so importar dados então talvez não precise ter relação no banco
  fator_atividade Int
  tmb Float
  get Float
  ingestao_recomendada Float
  adicionais_energeticos Float?
  observacoes String?

  data DateTime @default(now())
}
